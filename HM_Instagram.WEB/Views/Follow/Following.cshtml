@model List<HM_Instagram.BLL.DTOs.Follow.FollowDto>

@{
    ViewBag.Title = "Подписки";
}
@if (Model == null)
{
    <h1>@localizer["AnyFollowing"]</h1>
}
else
{

    <h2>@localizer["Following"]</h2>
    <ul>
        @foreach (var f in Model)
        {
            <li>
                    <img src="~/@f.Avatar" width="40" height="40"/>
                    @f.UserName
            </li>
        }
    </ul>
}