@using Microsoft.AspNetCore.Identity
@model Post
@inject UserManager<MyUser> UserManager

@{
    ViewBag.Title = "Detail";
    var currentUserId = int.Parse(UserManager.GetUserId(User));
    
}

@if (Model == null)
{
    <h5 class="text-center text-muted">@localizer["AnyPosts"]</h5>
}
else
{
    <div class="row justify-content-center">
        
        @if (Model == null)
        {
            <h1>@localizer["AnyPosts"]</h1>
        }
        else
        {
            <div class="col-6 mb-4">
                <div class="card shadow-sm rounded-3 border-0">

                    <div class="card-header bg-white border-0 d-flex align-items-center">
                        @if (Model.User == null)
                        {
                            <h1>ир</h1>
                        }
                        else
                        {
                            <img src="~/@Model.User.Avatar"
                                 alt="avatar"
                                 class="rounded-circle me-2"
                                 width="40" height="40"
                                 style="object-fit: cover;"/>
                            <strong>@Model.User.Name</strong>
                        }

                    </div>

                    <img src="~/@Model.Content"
                         class="w-100"
                         style="aspect-ratio: 1/1; object-fit: cover;"
                         alt="post img"/>

                    <div class="card-body pb-2">
                        <div class="d-flex align-items-center mb-2">
                            
                            <button id="like-button-@Model.Id"
                                    data-postid="@Model.Id"
                                    class="btn p-0 like-btn">
                                <i class="bi @(ViewBag.IsLiked ? "bi-heart-fill text-danger" : "bi-heart") fs-4"></i>
                            </button>

                            <span id="likes-count-@Model.Id">
                            @(Model.Reactions?.Count ?? 0)
                            </span>



                            <button class="btn p-0 view-comments-btn" asp-controller="Comment" asp-action="Index">
                                    <input type="hidden" name="PostId" value="@Model.Id"/>
                                    <i class="bi bi-chat fs-4"></i>
                                </button>
                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <h5 class="text-danger">@TempData["ErrorMessage"]</h5>
                                }
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <h5 class="text-danger">@TempData["SuccessMessage"]</h5>
                                }


                        </div>
                    </div>
                    <div>
                        <p>@Model.Desc</p>
                        <p>@Model.Ceated_Datetime</p>
                    </div>

                    <div class="card-footer bg-white border-0">
                        <form asp-action="AddComment" asp-controller="Comment" asp-route-PostId="@Model.Id" method="post" class="d-flex">
                            <input type="text" name="commentText" class="form-control me-2" placeholder="@localizer["AddComent"]..."/>
                            <button type="submit" class="btn btn-primary bi bi-send fs-4"></button>
                        </form>
                    </div>
                </div>
            </div>
        }
        }
    </div>
    @foreach (var comment in Model.Comments)
    {
        if(comment == null)
        {
            <h1>@localizer["AnyComment"]</h1>
        }
        else
        {
            <div class="d-flex align-items-start mb-2">
                <img src="~/@comment.User.Avatar"
                     alt="avatar"
                     class="rounded-circle me-2"
                     width="32" height="32"
                     style="object-fit: cover;" />

                <div>
                    <strong>@comment.User.UserName</strong>
                    <span>@comment.Comment</span>
                    <div class="text-muted small">
                        @comment.Created_DateTime.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>
        }
        
    }
}

@section Scripts{
    <script>
        $(document).ready(function (){
            $('.like-btn').click(function (e){
                e.preventDefault();
                
                let button = $(this);
                let postId = button.data("postid");

                $.ajax({
                    url: '@Url.Action("AddLike", "Reaction")',
                    type: "POST",
                    data: { PostId: postId },
                    success: function (response) {
                        let icon = button.find("i");

                        if (response.isLiked) {
                            icon.removeClass("bi-heart").addClass("bi-heart-fill text-danger");
                        } else {
                            icon.removeClass("bi-heart-fill text-danger").addClass("bi-heart");
                        }

                        $("#likes-count-" + postId).text(response.likescount);
                    },
                    error: function () {
                        alert("Ошибка при отправке лайка!");
                    }
                });
            })
        })
    </script>
}
