@using Microsoft.AspNetCore.Identity
@model MyUser
@inject UserManager<MyUser> UserManager

@{
    ViewBag.Title = "User profile";
    var currentUserId = int.Parse(UserManager.GetUserId(User));
    ViewBag.IsFollowing = Model.Followers.Any(f => f.FollowerId == currentUserId);
}
<div class="container mt-4">

    <div class="d-flex align-items-center mb-4" style="max-width: 800px; margin: auto;">
        <img src="~/@Model.Avatar" 
             class="rounded-circle me-4 border" 
             style="width: 120px; height: 120px; object-fit: cover;" 
             alt="avatar">

        <div class="flex-grow-1">
            <div class="d-flex align-items-center mb-3">
                <h3 class="me-3 mb-0">@Model.UserName</h3>

                @{
                    var someuserid = int.Parse(UserManager.GetUserId(User));
                }
                
                <button id="follow-button" class="btn @(ViewBag.IsFollowing ? "btn-outline-danger btn-sm" : "btn-primary btn-sm")" data-followedid="@Model.Id">
                    @(ViewBag.IsFollowing ? "Отписаться" : "Подписаться")
                </button>
            </div>

            <div class="d-flex gap-4 mb-2">
                <span><strong>@(Model?.Posts?.Count ?? 0)</strong> публикаций</span>
                <span>
                    <strong>
                        <a asp-controller="Follow" asp-action="Followers" asp-route-Id="@Model.Id" 
                           class="text-dark text-decoration-none">
                            <p id="followerscount">@(Model?.Followers?.Count ?? 0)</p>
                        </a>
                    </strong> подписчиков
                </span>
                <span>
                    <strong>
                        <a asp-controller="Follow" asp-action="Followed" asp-route-Id="@Model.Id" 
                           class="text-dark text-decoration-none">
                            @(Model?.Following?.Count ?? 0)
                        </a>
                    </strong> подписки
                </span>
            </div>

            <h6 class="fw-bold mb-0">@Model.Name</h6>
            <p class="text-muted">@Model.Desc</p>
        </div>
    </div>

    @if (Model.Posts == null || Model.Posts.Count == 0)
    {
        <h5 class="text-center text-muted">Нет постов</h5>
    }
    else
    {
        <div class="row g-1"> 
            @foreach (var con in Model.Posts)
            {
                <div class="col-4"> 
                    <div class="card border-0">
                        <a asp-controller="User" asp-action="DetailInfo" asp-route-PostId="@con.Id">
                            <img src="~/@con.Content"
                                 class="w-100"
                                 style="aspect-ratio: 1 / 1; object-fit: cover; cursor: pointer;"
                                 alt="post img"/>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>


@section Scripts
{
    <script>
        $(document).ready(function (){
            $('#follow-button').click(function (){
                let button = $(this);
                let followedId = button.data('followedid');
                let actionsUrl = "";
                
                if (button.text().trim() === "Подписаться"){
                    actionsUrl = "@Url.Action("Followed","Follow")"
                }else{
                    actionsUrl = "@Url.Action("UnFollowed","Follow")"
                }
                
                $.ajax({
                    url: actionsUrl,
                    type: "POST",
                    data: {followedId: followedId},
                    success: function (){
                        $('#followerscount').load('@Url.Action("GetFollowersCount", "Follow")' + '?id=' + @Model.Id)


                        if (button.text().trim() === "Подписаться"){
                            button.text("Отписаться")
                            button.removeClass("btn-primary").addClass("btn-outline-danger")
                        }else{
                            button.text("Подписаться");
                            button.removeClass("btn-outline-danger").addClass("btn-primary")
                        }
                    }
                })
            })
        })
    </script>
}
