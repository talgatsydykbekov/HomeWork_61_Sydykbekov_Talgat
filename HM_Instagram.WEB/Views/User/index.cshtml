@model MyUser

@{
    ViewBag.Title = "Profile";
}


<div class="container mt-4">

    <div class="d-flex align-items-center mb-4" style="max-width: 800px; margin: auto;">
        <img src="~/@Model.Avatar" class="rounded-circle me-4 border"
             style="width: 120px; height: 120px; object-fit: cover;" alt="avatar">

        <div class="flex-grow-1">
            <div class="d-flex align-items-center mb-3">
                <h3 class="me-3 mb-0">@Model.UserName</h3>
                <a class="btn btn-outline-success btn-sm" asp-action="Create" asp-controller="Post">
                    @localizer["AddPost"]
                </a>
            </div>

            <div class="d-flex gap-4 mb-2">
                <span><strong>@(Model?.Posts?.Count ?? 0)</strong>@localizer["NumberPosts"]</span>
                <span>
                    <strong>
                        <a class="text-dark text-decoration-none"
                           asp-controller="Follow" asp-action="Followers" asp-route-Id="@Model.Id">
                           @(Model?.Followers?.Count ?? 0)
                        </a>
                    </strong> @localizer["CountFollow"]
                </span>
                <span>
                    <strong>
                        <a class="text-dark text-decoration-none"
                           asp-controller="Follow" asp-action="Following" asp-route-Id="@Model.Id">
                           @(Model?.Following?.Count ?? 0)
                        </a>
                    </strong>@localizer["CountFollowing"]
                </span>
            </div>

            <h6 class="fw-bold mb-0">@Model.Name</h6>
            <p class="text-muted">@Model.Desc</p>
        </div>
    </div>

    
    @if (Model.Posts == null || Model.Posts.Count == 0)
    {
        <h5 class="text-center text-muted">@localizer["AnyPosts"]</h5>
    }
    else
    {
        <div class="row g-1">
            @foreach (var con in Model.Posts)
            {
                <div class="col-4">
                    <div class="card border-0">
                        <a asp-controller="User" asp-action="DetailInfo" asp-route-PostId="@con.Id">
                            <img src="~/@con.Content"
                                 class="w-100"
                                 style="aspect-ratio: 1 / 1; object-fit: cover; cursor: pointer;"
                                 alt="post img"/>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

