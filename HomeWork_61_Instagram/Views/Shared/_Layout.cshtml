<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - HomeWork_61_Instagram</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/HomeWork_61_Instagram.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house fa-xl me-2"></i>
                <span class="fw-bold">@localizer["NavMain"]</span>
            </a>

            <div class="mx-auto w-50">
                <form asp-action="SearchUsers" asp-controller="User" method="post" class="d-flex">
                    <input type="text" name="searchTitle" class="form-control me-2" placeholder="@localizer["NavHintSearch"]">
                    <button type="submit" class="btn btn-success">@localizer["NavSearch"]</button>
                </form>
            </div>

            <div class="d-flex align-items-center gap-3">

                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="User" asp-action="Index" class="d-flex align-items-center">
                        <img src="images/Profile/people.png" alt="Мой профиль" class="rounded-circle" width="40" height="40">
                    </a>

                    <form method="post" asp-controller="Account" asp-action="LogOff" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">@localizer["NavExit"]</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">@localizer["NavLogin"]</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success btn-sm">@localizer["NavSignIn"]</a>
                }
            </div>
        </div>
    </nav>
</header>

