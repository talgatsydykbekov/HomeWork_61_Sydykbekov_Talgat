@model List<MyUser>

@{
    ViewBag.Title = "Search users";
  
}


<div class="container mt-4" style="max-width: 600px;">
    <h4 class="mb-4">Результаты поиска</h4>

    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">Пользователи не найдены</p>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var user in Model)
            {
                <li class="list-group-item d-flex align-items-center">
                    <!-- Аватар -->
                    <img src="~/@user.Avatar"
                         class="rounded-circle me-3"
                         style="width: 50px; height: 50px; object-fit: cover;"
                         alt="avatar">

                    <!-- Ник -->
                    <div>
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@user.Id"
                           class="fw-semibold text-dark text-decoration-none">
                            @user.UserName
                        </a>
                        <div class="text-muted" style="font-size: 0.9em;">@user.Name</div>
                    </div>
                </li>
            }
        </ul>
    }
</div>