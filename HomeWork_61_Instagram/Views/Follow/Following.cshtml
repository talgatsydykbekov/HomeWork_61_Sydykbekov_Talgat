@model List<UserFollow>

@{
    ViewBag.Title = "Подписки";
}
@if (Model == null)
{
    <h1>@localizer["AnyFollowing"]</h1>
}
else
{

    <h2>@localizer["Following"]</h2>
    <ul>
        @foreach (var f in Model)
        {
            @if (f.Followed != null)
            {
                <li>
                    <img src="~/@f.Followed.Avatar" width="40" height="40"/>
                    @f.Followed.UserName
                </li>
            }
        }
    </ul>
}