@model List<UserFollow>

@{
    ViewBag.Title = "Подписки";
}

@if (Model == null)
{
    <h1>НЕт данных</h1>
}
else
{

    <h2>Подписчики</h2>
    <ul>
        @foreach (var f in Model)
        {
            <li>
                <img src="~/@f.Follower.Avatar" width="40" height="40"/>
                @f.Follower.UserName
            </li>
        }
    </ul>
}